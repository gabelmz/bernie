# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# --- Integration fallbacks -------------------------------------------------
# These are optional. Credentials entered on the Integrations page are sent
# with each request and take precedence; these env vars only act as defaults
# for headless or deployed runs.

# Asana personal access token (Profile settings > Apps > Manage Developer Apps)
ASANA_ACCESS_TOKEN=""
ASANA_WORKSPACE_GID=""
ASANA_PROJECT_GID=""

# Keepa API key (keepa.com > API access) and marketplace id (1 = amazon.com)
KEEPA_API_KEY=""
KEEPA_DOMAIN="1"

# Supabase project URL plus a service role or anon key
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_TABLE=""

# Google Sheets target (the OAuth token comes from the connected Google account)
SHEETS_SPREADSHEET_ID=""
SHEETS_TAB_NAME="Sheet1"

# AI providers. A key entered under Connections & APIs overrides these.
GEMINI_MODEL="gemini-3.1-pro-preview"
OPENROUTER_API_KEY=""
OPENROUTER_MODEL=""
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
HUGGINGFACE_TOKEN=""
HUGGINGFACE_MODEL=""

# Developer tools
OPENCODE_BASE_URL="http://localhost:4096"
OPENCODE_API_KEY=""
GITHUB_TOKEN=""
GITHUB_OWNER=""
GITHUB_REPO=""
GITHUB_API_BASE_URL="https://api.github.com"

# Supabase Auth (Google sign-in). The anon key is safe for the browser; the
# service role key above is server-only. Google must be enabled under
# Authentication > Providers, and the app origin listed under
# Authentication > URL Configuration > Redirect URLs.
SUPABASE_ANON_KEY=""

# --- Cloudflare (saved workflows) ------------------------------------------
# Used by wrangler for the Worker and its D1 database. Put real values in
# .env, which is gitignored; this file is names only.
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_API_TOKEN=""

# Shared secret the deployed Worker gates on. It must match in three places:
# here (so the dev server can forward it), .dev.vars (so `npm run worker:dev`
# accepts it), and `wrangler secret put BERNIE_API_SECRET` for the deployment.
# The Worker fails closed when it is unset.
BERNIE_API_SECRET=""

# Where the Express dev server forwards /api/workflows. Defaults to the local
# Worker started by `npm run worker:dev`.
WORKER_URL="http://127.0.0.1:8787"

# Build-time API base for a statically hosted front end, which has no Express
# process and would otherwise get 405 on every POST to /api/*. Point it at the
# deployed Worker. A runtime override lives in localStorage as
# `bernie-api-base`.
VITE_API_BASE_URL=""

# R2, if the same token is used for object storage.
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_S3_ENDPOINT=""
